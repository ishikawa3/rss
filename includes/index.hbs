<!DOCTYPE html>
<html lang="en">

  <head>
    <title>{{siteTitle}}</title>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="shortcut icon" type="image/x-icon" href="favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="{{siteTitle}}" href="{{feedHref}}" />

    <!-- Google Fonts: Noto Serif JP + Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Noto+Serif+JP:wght@400;700&display=swap" rel="stylesheet">
    <!-- Material Icons (for chevron) -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

    <link href="index.css?{{cliVersion}}" rel="stylesheet" />
    <!-- %before-head-end.html% -->
  </head>

  <body>
    <!-- %after-body-begin.html% -->

    <header class="app-bar">
      <div class="app-bar__content">
        <h1 class="app-bar__title">
          <span class="app-bar__accent-line"></span>
          {{siteTitle}}
        </h1>
      </div>
    </header>

    <main class="main-content">
      {{#each dates}}
        <section class="day-section">
          <div class="day-header">
            <button
              class="day-toggle"
              data-action="toggle-accordions"
              title="Click to toggle the day, Ctrl + click to toggle all."
            >
              <div class="day-toggle__content">
                <time class="day-toggle__weekday js-offset-weekday" data-offset-date={{isoOffsetPublishDate}} datetime="{{isoUtcPublishTime}}">{{isoOffsetPublishDate}}</time>
                <time class="day-toggle__date js-offset-date" data-offset-date={{isoOffsetPublishDate}} datetime="{{isoUtcPublishTime}}"></time>
              </div>
            </button>
          </div>

          <div class="sources-container">
            {{#each sources}}
              <div class="source-card">
                <div class="source-header">
                  <button
                    class="source-toggle"
                    data-action="toggle-accordions"
                    title="Click to toggle the source, Ctrl + click to toggle all."
                  >
                    <span class="source-toggle__title">{{title}}</span>
                  </button>
                  <a class="source-link" href="{{siteUrl}}">
                    <span class="material-icons">open_in_new</span>
                    Visit
                  </a>
                </div>

                <div class="articles-container">
                  {{#each articles}}
                    <article class="article-card">
                      <details
                        class="article-details"
                        data-action="toggle-native-accordion"
                        data-accordion-key="{{id}}"
                        open
                      >
                        <summary class="article-summary">
                          <span class="article-summary__title">{{title}}</span>
                          <span class="material-icons article-summary__chevron">expand_more</span>
                        </summary>

                        <div class="article-content">
                          <a class="article-link" href="{{link}}">
                            <div class="article-body">
                              {{#if imageUrl}}
                                <img src="{{imageUrl}}" loading="lazy" class="article-image" alt="" />
                              {{/if}}
                              <div class="article-text">
                                <p class="article-description">{{description}}</p>
                                {{#if readingTimeInMin}}
                                  <span class="article-reading-time">
                                    <span class="material-icons">schedule</span>
                                    {{readingTimeInMin}} min read
                                  </span>
                                {{/if}}
                              </div>
                            </div>
                          </a>
                        </div>
                      </details>
                    </article>
                  {{/each}}
                </div>
              </div>
            {{/each}}
          </div>
        </section>
      {{else}}
        <!-- Demo content when no feed data is available -->
        <section class="day-section">
          <div class="day-header">
            <button class="day-toggle">
              <div class="day-toggle__content">
                <time class="day-toggle__weekday">Today</time>
                <time class="day-toggle__date">AXIS Design Demo</time>
              </div>
            </button>
          </div>

          <div class="sources-container">
            <div class="source-card">
              <div class="source-header">
                <button class="source-toggle">
                  <span class="source-toggle__title">Dezeen</span>
                </button>
                <a class="source-link" href="https://dezeen.com">
                  <span class="material-icons">open_in_new</span>
                  Visit
                </a>
              </div>

              <div class="articles-container">
                <article class="article-card">
                  <details class="article-details" open>
                    <summary class="article-summary">
                      <span class="article-summary__title">The Future of Sustainable Architecture</span>
                      <span class="material-icons article-summary__chevron">expand_more</span>
                    </summary>
                    <div class="article-content">
                      <a class="article-link" href="#demo">
                        <div class="article-body">
                          <div class="article-text">
                            <p class="article-description">Exploring how architects are reimagining the built environment with eco-conscious materials and biophilic design principles.</p>
                            <span class="article-reading-time">
                              <span class="material-icons">schedule</span>
                              6 min read
                            </span>
                          </div>
                        </div>
                      </a>
                    </div>
                  </details>
                </article>

                <article class="article-card">
                  <details class="article-details" open>
                    <summary class="article-summary">
                      <span class="article-summary__title">Industrial Design Trends for 2026</span>
                      <span class="material-icons article-summary__chevron">expand_more</span>
                    </summary>
                    <div class="article-content">
                      <a class="article-link" href="#demo">
                        <div class="article-body">
                          <div class="article-text">
                            <p class="article-description">A look at how product designers are balancing form, function, and environmental responsibility in the post-pandemic era.</p>
                            <span class="article-reading-time">
                              <span class="material-icons">schedule</span>
                              4 min read
                            </span>
                          </div>
                        </div>
                      </a>
                    </div>
                  </details>
                </article>
              </div>
            </div>
          </div>
        </section>
      {{/each}}
    </main>

    <footer class="footer">
      <div class="footer__content">
        {{#if githubRunUrl}}
        <a class="footer__link" href="{{githubRunUrl}}">
          <span class="material-icons">schedule</span>
          <time id="build-timestamp" datetime="{{siteBuildTimestamp}}">{{siteBuildTimestamp}}</time>
        </a>
        {{else}}
        <div class="footer__item">
          <span class="material-icons">schedule</span>
          <time id="build-timestamp" datetime="{{siteBuildTimestamp}}">{{siteBuildTimestamp}}</time>
        </div>
        {{/if}}
        <a class="footer__link" href="{{projectUrl}}">
          <span class="material-icons">code</span>
          osmosfeed {{cliVersion}}
        </a>
      </div>
    </footer>

    <script src="index.js?{{cliVersion}}"></script>
    <!-- %before-body-end.html% -->
  </body>

</html>